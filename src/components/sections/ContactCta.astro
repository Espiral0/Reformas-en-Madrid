---
import { site } from '../../data/site';

const inputClass =
  'w-full bg-surface-warm px-space-md py-3 rounded-lg text-body-md text-on-surface placeholder:text-outline/70 focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary/20 transition-all';
---

<section id="presupuesto-form" class="w-full py-space-3xl bg-surface-container-highest relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-center">
    <div class="lg:col-span-6 flex flex-col gap-space-md">
      <span class="font-label-sm text-label-sm uppercase tracking-widest text-primary font-bold">Hablemos hoy mismo</span>
      <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface font-bold tracking-tight">¿Hablamos de tu reforma?</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant">
        Visita y presupuesto gratis, sin ningún tipo de compromiso. Evaluamos tu vivienda en Madrid y te enviamos la propuesta detallada en menos de 24 horas.
      </p>
      <div class="flex flex-col sm:flex-row gap-space-sm pt-space-sm">
        <a class="flex items-center justify-center gap-space-xs bg-on-surface text-surface-lowest px-space-lg py-3.5 rounded-lg font-label-lg text-label-lg hover:bg-surface-tint transition-colors font-bold shadow-sm" href={site.phoneHref}>
          <span class="material-symbols-outlined text-[22px]">call</span>
          <span>Llamar ahora: {site.phone}</span>
        </a>
        <a class="flex items-center justify-center gap-space-xs bg-whatsapp text-surface-lowest px-space-lg py-3.5 rounded-lg font-label-lg text-label-lg hover:opacity-90 transition-opacity font-bold shadow-sm" href={site.whatsappHref} rel="noopener noreferrer" target="_blank">
          <span class="material-symbols-outlined text-[22px]">chat</span>
          <span>WhatsApp directo</span>
        </a>
      </div>
    </div>

    <div class="lg:col-span-6">
      <div class="bg-surface-container-lowest p-space-lg md:p-space-xl rounded-2xl shadow-xl flex flex-col gap-space-md">
        <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">Pide tu presupuesto online</h3>
        <form class="flex flex-col gap-space-sm" data-lead-form data-success="¡Solicitud enviada con éxito! Nos comunicaremos contigo enseguida.">
          <input type="hidden" name="formulario" value="contacto" />
          <input type="text" name="empresa" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
          <div>
            <label class="block font-label-md text-label-md text-on-surface mb-1" for="cta-nombre">Nombre completo</label>
            <input class={inputClass} id="cta-nombre" name="nombre" placeholder="Tu nombre y apellidos" required type="text" autocomplete="name" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
            <div>
              <label class="block font-label-md text-label-md text-on-surface mb-1" for="cta-tel">Teléfono</label>
              <input class={inputClass} id="cta-tel" name="telefono" placeholder={site.phone} required type="tel" autocomplete="tel-national" />
            </div>
            <div>
              <label class="block font-label-md text-label-md text-on-surface mb-1" for="cta-cp">Código Postal</label>
              <input class={inputClass} id="cta-cp" name="cp" maxlength="5" inputmode="numeric" pattern="[0-9]{5}" placeholder="28008 Madrid" required type="text" autocomplete="postal-code" />
            </div>
          </div>
          <div>
            <label class="block font-label-md text-label-md text-on-surface mb-1" for="cta-tipo">Tipo de obra requerida</label>
            <select class={inputClass} id="cta-tipo" name="tipo">
              <option value="integral">Reforma Integral de Vivienda</option>
              <option value="bano">Reforma de Baño</option>
              <option value="cocina">Reforma de Cocina</option>
              <option value="otro">Reforma Parcial o Local Comercial</option>
            </select>
          </div>
          <div class="flex items-start gap-space-xs pt-1">
            <input class="mt-1 h-4 w-4 rounded accent-primary" id="cta-check" name="privacidad" required type="checkbox" />
            <label class="font-caption text-caption text-on-surface-variant" for="cta-check">
              Acepto la <a class="text-primary underline" href="/politica-de-privacidad" target="_blank">política de protección de datos</a> para recibir asesoramiento técnico.
            </label>
          </div>
          <button class="w-full mt-2 bg-primary text-on-primary font-label-lg text-label-lg py-3.5 px-space-lg rounded-lg shadow-md hover:bg-primary-container transition-all text-center font-bold" type="submit">
            Enviar solicitud gratuita
          </button>
          <p data-form-status class="hidden" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>
