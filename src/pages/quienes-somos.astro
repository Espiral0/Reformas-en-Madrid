---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import WhyUs from '../components/sections/WhyUs.astro';
import Team from '../components/sections/Team.astro';
import Brands from '../components/sections/Brands.astro';

const stats = [
  { value: '+20', label: 'años de experiencia' },
  { value: '+500', label: 'pisos reformados' },
  { value: '4,9/5', label: 'en Google (34 reseñas)' },
  { value: '3 años', label: 'de garantía por escrito' },
];
---

<Layout
  title="Quiénes somos | Reformas en Madrid"
  description="Estudio de arquitectura y reformas integrales en Madrid con más de 20 años de experiencia y equipo propio en plantilla."
>
  <PageHeader eyebrow="Quiénes somos" title="Dos décadas reformando hogares en Madrid" image="/images/hero.jpg" breadcrumbs={[{ label: 'Quiénes somos' }]}>
    Estudio de arquitectura y reformas integrales residenciales. Proyectos llave en mano con rigor técnico, diseño atemporal y un equipo propio que cuida cada detalle.
  </PageHeader>

  <section class="w-full py-space-2xl bg-surface">
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin grid grid-cols-2 lg:grid-cols-4 gap-space-lg">
      {stats.map((s) => (
        <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm text-center flex flex-col gap-1">
          <span class="font-display text-headline-lg font-bold text-primary">{s.value}</span>
          <span class="font-label-md text-label-md text-on-surface-variant">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <WhyUs />
  <Team />
  <Brands />
</Layout>
