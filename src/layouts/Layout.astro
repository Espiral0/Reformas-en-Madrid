---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import ContactCta from '../components/sections/ContactCta.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { analytics } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Reformas integrales de pisos en Madrid con precio cerrado, plazos por contrato, equipo propio y garantía de 3 años.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <title>{title}</title>

    <!-- Google Consent Mode v2 (Inicialización antes de cualquier script de medición) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      // Comprobar preferencias guardadas
      var consentData = null;
      try {
        var raw = localStorage.getItem('rm_cookie_consent');
        if (raw) consentData = JSON.parse(raw);
      } catch (e) {}

      var analyticsGranted = Boolean(consentData && consentData.analytics);
      var marketingGranted = Boolean(consentData && consentData.marketing);

      // Estado de consentimiento por defecto conforme a Consent Mode v2
      gtag('consent', 'default', {
        ad_storage: marketingGranted ? 'granted' : 'denied',
        ad_user_data: marketingGranted ? 'granted' : 'denied',
        ad_personalization: marketingGranted ? 'granted' : 'denied',
        analytics_storage: analyticsGranted ? 'granted' : 'denied',
        functionality_storage: 'granted',
        personalization_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500,
      });
    </script>

    {/* Si el comprador configura Google Tag Manager */}
    {analytics.gtmId && (
      <script is:inline define:vars={{ gtmId: analytics.gtmId }}>
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'dataLayer', gtmId);
      </script>
    )}

    {/* Si el comprador configura Google Ads */}
    {analytics.googleAdsId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analytics.googleAdsId}`}></script>
        <script is:inline define:vars={{ adsId: analytics.googleAdsId }}>
          gtag('js', new Date());
          gtag('config', adsId);
        </script>
      </>
    )}

    {/* Si el comprador configura solo GA4 */}
    {analytics.ga4Id && !analytics.googleAdsId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analytics.ga4Id}`}></script>
        <script is:inline define:vars={{ gaId: analytics.ga4Id }}>
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block"
      rel="stylesheet"
    />
  </head>
  <body class="bg-surface font-body-md text-body-md text-on-surface antialiased">
    <Header />
    <main class="w-full pt-20 bg-surface min-h-[calc(100vh-80px)] pb-20 md:pb-0">
      <slot />
      <ContactCta />
    </main>
    <FloatingContact />
    <Footer />
    <CookieBanner />
  </body>
</html>

<script>
  import '../scripts/lead-forms';
</script>
