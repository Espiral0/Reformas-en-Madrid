# Copia este archivo como .env y rellena los valores.

# API key de https://resend.com/api-keys (sin ella, en desarrollo las solicitudes solo se muestran en la consola)
RESEND_API_KEY=

# Correo que recibe las solicitudes de presupuesto
LEAD_TO_EMAIL=info@reformasenmadrid.biz

# Remitente. onboarding@resend.dev solo puede enviar al email con el que te registraste en Resend;
# para enviar a cualquier dirección, verifica tu dominio en Resend y usa p. ej. web@reformasenmadrid.biz
LEAD_FROM_EMAIL=Reformas en Madrid <onboarding@resend.dev>
